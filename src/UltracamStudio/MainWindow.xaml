<Window x:Class="UltracamStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ultracam Studio Pro" Width="1440" Height="900" MinWidth="1080" MinHeight="680" Background="#10131A" Foreground="White" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border BorderBrush="#2A3040" BorderThickness="0,0,0,1" Padding="20,10"><DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Source="Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ULTRACAM" FontSize="20" FontWeight="Bold"/><TextBlock Text="STUDIO PRO" FontSize="10" Foreground="#A59BEF"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RecordButton" Content="●  Enregistrer" Click="Record_Click"/><Button Content="Photo" Click="Snapshot_Click"/><Button Content="Ouvrir les captures" Click="OpenCaptures_Click"/><Button Content="Installer la caméra virtuelle" Click="InstallCamera_Click" Background="#7460E8"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" Padding="18,0,18,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="SOURCE MOBILE" Style="{StaticResource Section}"/><TextBlock x:Name="DeviceName" Text="Aucun téléphone connecté" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <WrapPanel><Button Content="Arrière" Tag="back" Click="Lens_Click"/><Button Content="Avant" Tag="front" Click="Lens_Click"/></WrapPanel>
    <CheckBox x:Name="Torch" Content="Torche" Click="Torch_Click"/><TextBlock Text="Zoom caméra"/><Slider x:Name="CameraZoom" Minimum="0" Maximum="1" ValueChanged="CameraZoom_Changed"/>
    <TextBlock Text="IMAGE" Style="{StaticResource Section}"/><TextBlock Text="Exposition numérique"/><Slider x:Name="Exposure" Minimum="-2" Maximum="2" Value="0"/>
    <TextBlock Text="Contraste"/><Slider x:Name="Contrast" Minimum="0.4" Maximum="2" Value="1"/>
    <TextBlock Text="Saturation"/><Slider x:Name="Saturation" Minimum="0" Maximum="2" Value="1"/>
    <TextBlock Text="Température"/><Slider x:Name="Temperature" Minimum="-1" Maximum="1" Value="0"/>
    <TextBlock Text="Gamma"/><Slider x:Name="Gamma" Minimum="0.4" Maximum="2" Value="1"/>
    <TextBlock Text="CADRAGE" Style="{StaticResource Section}"/><CheckBox x:Name="Mirror" Content="Miroir horizontal"/><CheckBox x:Name="FillFrame" Content="Remplir le cadre (recadrage)"/>
    <Button Content="Rotation 90°" Click="Rotate_Click"/><Button Content="Réinitialiser les réglages" Click="Reset_Click"/>
    <TextBlock Text="SORTIE" Style="{StaticResource Section}"/><TextBlock Text="1280 × 720 · 30 fps maximum" FontSize="11" Foreground="#A7B3C8"/><TextBlock x:Name="CameraStatus" Text="Caméra virtuelle désactivée" TextWrapping="Wrap" FontSize="11" Margin="0,8"/>
    <CheckBox x:Name="VirtualEnabled" Content="Activer la sortie virtuelle" Click="Virtual_Click"/>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="1" Margin="18"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="PROGRAMME" FontSize="11" FontWeight="Bold" Foreground="#A7B3C8" VerticalAlignment="Center"/><Border Background="#252B3A" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right"><TextBlock x:Name="LiveLabel" Text="EN ATTENTE" FontSize="10"/></Border></DockPanel>
    <Border Grid.Row="1" Background="#080B10" BorderBrush="#30374A" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><Grid><Image x:Name="VideoPreview" Stretch="Uniform"/><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><Image Source="Assets/logo.png" Width="86" Height="86"/><TextBlock Text="Votre prochaine prise commence ici." FontSize="21" Margin="0,24,0,12" HorizontalAlignment="Center"/><TextBlock Text="Ouvrez Ultracam Remote Mobile et scannez le QR code." Foreground="#8D9AB0" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CADENCE REÇUE" FontSize="9" Foreground="#8997AE"/><TextBlock x:Name="FpsLabel" Text="— fps" FontSize="18" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TRANSPORT" FontSize="9" Foreground="#8997AE"/><TextBlock x:Name="TransportLabel" Text="—" FontSize="18" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ENREGISTREMENT" FontSize="9" Foreground="#8997AE"/><TextBlock x:Name="RecordingLabel" Text="Prêt" FontSize="18" Margin="0,5,0,0"/></StackPanel></Grid>
   </Grid>
   <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="18,0,18,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="CONNECTER UN TÉLÉPHONE" Style="{StaticResource Section}"/><Border Background="White" Padding="10" CornerRadius="8"><Image x:Name="PairingQr" Width="196" Height="196"/></Border>
    <TextBlock x:Name="ConnectionHelp" Text="Scannez avec Ultracam Remote Mobile, sur le même réseau privé." TextWrapping="Wrap" FontSize="12" Foreground="#A7B3C8" Margin="0,12"/>
    <ComboBox x:Name="AddressSelector" SelectionChanged="Address_Changed" Margin="0,4,0,10"/>
    <Button Content="Actualiser le réseau Wi-Fi" Click="RefreshNetwork_Click"/>
    <TextBlock Text="ANDROID PAR USB" Style="{StaticResource Section}"/>
    <TextBlock Text="Branchez un câble de données, activez le débogage USB et autorisez ce PC sur le téléphone." TextWrapping="Wrap" FontSize="12" Foreground="#A7B3C8"/>
    <ComboBox x:Name="UsbDevices" Margin="0,8" AutomationProperties.Name="Téléphone Android USB"/>
    <Button x:Name="UsbButton" Content="Connecter en USB" Click="Usb_Click" IsEnabled="False"/>
    <Button Content="Copier le lien de connexion" Click="CopyPairing_Click"/><Button Content="Renouveler le code" Click="RenewPairing_Click"/>
    <TextBlock Text="Le lien autorise la connexion. Transport local non chiffré : utilisez un réseau de confiance." TextWrapping="Wrap" FontSize="10" Foreground="#9AA7BD" Margin="0,10"/>
    <TextBlock Text="STYLES D’IMAGE" Style="{StaticResource Section}"/>
    <Button Content="Naturel" Tag="natural" Click="Preset_Click"/><Button Content="Studio lumineux" Tag="bright" Click="Preset_Click"/><Button Content="Cinéma chaud" Tag="warm" Click="Preset_Click"/><Button Content="Noir et blanc" Tag="mono" Click="Preset_Click"/><Button Content="Couleurs vives" Tag="vivid" Click="Preset_Click"/>
    <TextBlock Text="VOTRE STUDIO" Style="{StaticResource Section}"/><TextBlock Text="Fonctions implémentées accessibles sans abonnement." TextWrapping="Wrap" FontSize="12" Foreground="#A7B3C8"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" Background="#191D27" Padding="18,9"><TextBlock x:Name="StatusText" Text="Démarrage du studio…" FontSize="11" Foreground="#A7B3C8"/></Border>
 </Grid>
</Window>

<Application x:Class="UltracamStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#191D27"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6EAF3"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#30374A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,4,6,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#494264"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#7460E8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,8,0,16"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#252C3C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,8"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="#9AA7BD"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,22,0,12"/></Style>
 </Application.Resources>
</Application>
